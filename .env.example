# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to git or share it anywhere.

# Stripe secret key (test mode key starts with sk_test_...)
STRIPE_SECRET_KEY=sk_test_your_key_here

# Stripe webhook signing secret (get this from `stripe listen` while testing,
# or from the Dashboard > Developers > Webhooks once you add an endpoint)
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Percentage MII FITT keeps from each client payment, e.g. 10 = 10%
PLATFORM_FEE_PERCENT=10

# Where your front-end app is running, so Stripe onboarding can redirect back to it
APP_URL=http://localhost:5173

# Port this server runs on
PORT=4242

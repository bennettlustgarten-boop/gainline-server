# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to git or share it anywhere.

# Stripe secret key (test mode key starts with sk_test_...)
STRIPE_SECRET_KEY=sk_test_your_key_here

# Stripe webhook signing secret (get this from `stripe listen` while testing,
# or from the Dashboard > Developers > Webhooks once you add an endpoint)
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Percentage Gainline keeps from each client payment, e.g. 10 = 10%.
# Default is 0 — coaches keep 100% of client payments. Gainline's revenue
# comes from coach membership tiers and the ad listing fee instead.
PLATFORM_FEE_PERCENT=0

# Where this app is running, so Stripe onboarding/checkout can redirect back to
# it. The front-end is served by this same server (see /public), so this
# should match PORT below unless you deploy the front-end separately.
APP_URL=http://localhost:4242

# Port this server runs on
PORT=4242

# Random string used to sign session cookies — any long random value works.
SESSION_SECRET=change_me_to_a_long_random_string

# Anthropic API key for the coach AI assistant tab (console.anthropic.com).
# Leave as-is to disable the assistant for now.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Resend (resend.com) API key — sends the "Contact Support" form and
# account emails (verification, password reset). Sign up at resend.com,
# create an API key under "API Keys". Until you verify a domain under
# "Domains", Resend only delivers to the email address that owns this key
# — fine for local testing, but real signups need a verified sending
# domain (see FROM_ADDRESS in lib/mailer.js). Leave blank to disable all
# outbound email.
RESEND_API_KEY=

# Where data.db and /uploads are stored. Leave unset for local dev (defaults
# to the project root). In production this must point at a persistent disk
# (e.g. a Render Disk's mount path) — without it, all data and uploaded
# files are wiped on every deploy/restart.
DATA_DIR=
